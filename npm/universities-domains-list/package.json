{
  "name": "universities-domains-list",
  "version": "0.1.0",
  "description": "Hipo's world university names, countries, websites, and domains as JSON.",
  "keywords": [
    "dataset",
    "domains",
    "education",
    "json",
    "universities",
    "university"
  ],
  "homepage": "https://github.com/leonsilicon/university-domains-list/tree/master/npm/universities-domains-list#readme",
  "bugs": {
    "url": "https://github.com/leonsilicon/university-domains-list/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonsilicon/university-domains-list.git",
    "directory": "npm/universities-domains-list"
  },
  "files": [
    "dist",
    "world_universities_and_domains.json",
    "LICENSE.txt"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./world_universities_and_domains.json": "./world_universities_and_domains.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/copy-data.ts && vp pack",
    "check": "vp check",
    "test": "vp test run",
    "prepack": "bun run build",
    "release": "vp pm publish --access public"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "~6.0.3",
    "vite-plus": "^1.4.0"
  },
  "packageManager": "bun@1.4.4"
}
