{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "strict": true,
    "noEmit": true,
    "types": ["bun"]
  },
  "include": ["src", "scripts", "tests", "vite.config.ts"]
}
